{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src/public",
    "outDir": "public",
    "strict": false,
    "allowJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "declaration": false,
    "removeComments": false
  },
  "include": ["src/public/**/*.ts"]
}
